// Esquema del servicio de la feria.
// La URL de conexión incluye ?schema=feria para aislar sus tablas del resto de servicios.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoItem {
  SERVICIO
  PRODUCTO

  @@map("tipo_item")
}

model Evento {
  id               Int            @id @default(autoincrement())
  nombre           String         @db.VarChar(150)
  anio             Int
  fechaInicio      DateTime       @map("fecha_inicio") @db.Timestamptz(6)
  fechaFin         DateTime       @map("fecha_fin") @db.Timestamptz(6)
  telefonoAtencion String?        @map("telefono_atencion") @db.VarChar(20)
  activo           Boolean        @default(false)
  confirmaciones   Confirmacion[]

  // Solo un evento activo a la vez: índice único parcial creado en la migración SQL
  @@map("evento")
}

model Item {
  id          Int                @id @default(autoincrement())
  tipo        TipoItem
  nombre      String             @db.VarChar(150)
  descripcion String?
  precio      Decimal            @db.Decimal(10, 2)
  activo      Boolean            @default(true)
  confirmados ConfirmacionItem[]

  @@map("item")
}

model Confirmacion {
  id                  Int                @id @default(autoincrement())
  eventoId            Int                @map("evento_id")
  // Viene del JWT emitido por auth-service. Sin llave foránea: cada servicio es dueño de sus datos.
  usuarioId           Int                @map("usuario_id")
  fechaHoraAsistencia DateTime           @map("fecha_hora_asistencia") @db.Timestamptz(6)
  descuentoServicios  Decimal            @default(0) @map("descuento_servicios") @db.Decimal(5, 2)
  descuentoProductos  Decimal            @default(0) @map("descuento_productos") @db.Decimal(5, 2)
  creadoEn            DateTime           @default(now()) @map("creado_en") @db.Timestamptz(6)
  evento              Evento             @relation(fields: [eventoId], references: [id])
  items               ConfirmacionItem[]

  @@unique([eventoId, usuarioId])
  @@map("confirmacion")
}

model ConfirmacionItem {
  confirmacionId Int          @map("confirmacion_id")
  itemId         Int          @map("item_id")
  // Precio al momento de confirmar: si el catálogo cambia, el portafolio conserva lo que vio el cliente
  precioUnitario Decimal      @map("precio_unitario") @db.Decimal(10, 2)
  confirmacion   Confirmacion @relation(fields: [confirmacionId], references: [id], onDelete: Cascade)
  item           Item         @relation(fields: [itemId], references: [id])

  @@id([confirmacionId, itemId])
  @@map("confirmacion_item")
}
