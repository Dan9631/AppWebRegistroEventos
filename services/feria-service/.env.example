NODE_ENV=development
PORT=4002

# Base de datos compartida; cada servicio usa su propio esquema
DATABASE_URL=postgresql://disagro:disagro@localhost:5432/disagro?schema=feria

# Llave pública de auth-service (la misma JWT_PUBLIC_KEY de su .env).
# Este servicio solo valida tokens; nunca necesita la llave privada.
JWT_PUBLIC_KEY=
JWT_ISSUER=disagro-auth
