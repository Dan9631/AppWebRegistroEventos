NODE_ENV=development
PORT=4001

# Base de datos compartida; cada servicio usa su propio esquema
DATABASE_URL=postgresql://disagro:disagro@localhost:5432/disagro?schema=auth

# URL del frontend: se usa para CORS y para armar el enlace de verificación
FRONTEND_URL=http://localhost:5173

# Generar con: npm run keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=disagro-auth
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DIAS=7
VERIFICACION_TTL_HORAS=24

# En producción con frontend y API en dominios distintos: COOKIE_SECURE=true y COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Sin API key el correo no se envía, pero el enlace se imprime en el log (fuera de producción).
# Sin dominio verificado en Resend, solo se puede enviar desde onboarding@resend.dev
# y únicamente al correo dueño de la cuenta de Resend.
RESEND_API_KEY=
EMAIL_FROM=Disagro <onboarding@resend.dev>
